# ── Claude API ────────────────────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Загвар ба зардлын тохиргоо (заавал биш).
# BOT_ угтвар нь Claude Code зэрэг хэрэгслийн CLAUDE_* хувьсагчтай мөргөлдөхөөс сэргийлнэ.
# Идэвхтэй нийлүүлэгчийн загвар. Anthropic дээр хоосон орхивол claude-sonnet-5.
# OpenAI дээр ЗААВАЛ загварын нэрээ бичнэ.
BOT_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max — чатботод low хангалттай бөгөөд хурдан
BOT_EFFORT=low
BOT_MAX_TOKENS=1500

# ── Facebook ──────────────────────────────────────────────────
# developers.facebook.com → App → Messenger → Settings
# Webhook тохируулахдаа өөрөө сонгож бичих санамсаргүй тэмдэгт мөр
FB_VERIFY_TOKEN=oorchloh-nuuts-tekst-1234
# Page Access Token (хуудсаа сонгоод "Generate token")
FB_PAGE_ACCESS_TOKEN=EAAG...
# App Secret (App → Settings → Basic → App Secret → Show)
FB_APP_SECRET=abc123...
FB_GRAPH_VERSION=v21.0

# Хүн рүү шилжүүлэх хүсэлт ирэхэд Messenger-ээр мэдэгдэл авах PSID-үүд (таслалаар)
# PSID-ээ мэдэхгүй бол хоосон орхиж болно — хүсэлтүүд data/escalations.jsonl-д хадгалагдана
FB_ADMIN_PSIDS=

# ── Сервер ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Яриа ──────────────────────────────────────────────────────
SESSION_TTL_MINUTES=60
SESSION_MAX_TURNS=12

# ── Redis (Vercel дээр ЗААВАЛ) ────────────────────────────────
# Serverless дээр функцийн санах ой дуудлага бүрт цэвэрлэгддэг тул ярианы
# түүхийг гадаад хадгалалтад байршуулна. Vercel → Storage → Upstash for Redis
# сонгоод төслөө холбоход эдгээр хувьсагч автоматаар нэмэгдэнэ.
# Байнга ажилладаг сервер (VPS, Railway) дээр хоосон орхиж болно.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Хяналтын самбар ───────────────────────────────────────────
# Элсэгчдийн жагсаалт харах /admin хуудасны нууц үг.
# Тохируулаагүй бол тэр хуудас огт нээгдэхгүй (404).
# Хүчтэй, санамсаргүй утга сонгоно уу — энэ хуудас хувийн мэдээлэл харуулна.
# ADMIN_TOKEN=

# ── QPay (суудал баталгаажуулах төлбөр) ───────────────────────
# Тохируулаагүй бол бот нэхэмжлэх үүсгэхийн оронд ажилтан руу чиглүүлнэ.
# QPAY_USERNAME=
# QPAY_PASSWORD=
# QPAY_INVOICE_CODE=
# QPAY_BASE_URL=https://merchant.qpay.mn
# Callback хаяг үүсгэхэд ашиглана (deploy хийсэн домэйн)
# PUBLIC_BASE_URL=https://deed-ai.vercel.app

# ── Нэмэлт ────────────────────────────────────────────────────
# ЗӨВХӨН локал тест дээр 1 болгоно. Production дээр хэзээ ч бүү асаа!
# FB_SKIP_SIGNATURE_CHECK=0

# --- AI нийлүүлэгч ---
# anthropic (өгөгдмөл) | openai
AI_PROVIDER=anthropic

# AI_PROVIDER=openai үед ЗААВАЛ хэрэгтэй.
# ⚠️ Түлхүүрээ Vercel → Settings → Environment Variables дээр ӨӨРӨӨ оруулна.
#    Чат, мессеж, git-д хэзээ ч бүү бич.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# responses (өгөгдмөл) | chat — хэрэгсэлтэй ажиллах шинэ загварууд
# /v1/responses шаарддаг. Хуучин загварт chat гэж тохируулна.
# OPENAI_API_STYLE=responses

# --- Сэтгэгдэлд автоматаар хариулах ---
# Хуудсан дээр сэтгэгдэл бичсэн хүн рүү Messenger-ээр хувийн мессеж
# илгээж, ботын яриаг эхлүүлнэ.
#
# Асаахын өмнө ЗААВАЛ хийх зүйлс (README-г үзнэ үү):
#   1. App Review: pages_manage_engagement эрх авах
#   2. Webhook дээр "feed" талбарыг захиалах
#   3. FB_PAGE_ID-г бөглөх
FB_COMMENT_AUTOREPLY=false

# Хуудасны ID — өөрийн сэтгэгдэлд хариулахаас сэргийлнэ (ЗААВАЛ)
# FB_PAGE_ID=

# Сэтгэгдэлд нийтээр харагдах хариу бичих эсэх
FB_COMMENT_PUBLIC_REPLY=true
