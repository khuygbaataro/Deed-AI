# ── Claude API ────────────────────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Загвар ба зардлын тохиргоо (заавал биш)
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max — чатботод low хангалттай бөгөөд хурдан
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=1500

# ── Facebook ──────────────────────────────────────────────────
# developers.facebook.com → App → Messenger → Settings
# Webhook тохируулахдаа өөрөө сонгож бичих санамсаргүй тэмдэгт мөр
FB_VERIFY_TOKEN=oorchloh-nuuts-tekst-1234
# Page Access Token (хуудсаа сонгоод "Generate token")
FB_PAGE_ACCESS_TOKEN=EAAG...
# App Secret (App → Settings → Basic → App Secret → Show)
FB_APP_SECRET=abc123...
FB_GRAPH_VERSION=v21.0

# Хүн рүү шилжүүлэх хүсэлт ирэхэд Messenger-ээр мэдэгдэл авах PSID-үүд (таслалаар)
# PSID-ээ мэдэхгүй бол хоосон орхиж болно — хүсэлтүүд data/escalations.jsonl-д хадгалагдана
FB_ADMIN_PSIDS=

# ── Сервер ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Яриа ──────────────────────────────────────────────────────
SESSION_TTL_MINUTES=60
SESSION_MAX_TURNS=12

# ── Нэмэлт ────────────────────────────────────────────────────
# Тохируулбал POST /admin/reload -оор мэдлэгийн санг дахин ачаалж болно
# ADMIN_TOKEN=
# ЗӨВХӨН локал тест дээр 1 болгоно. Production дээр хэзээ ч бүү асаа!
# FB_SKIP_SIGNATURE_CHECK=0
